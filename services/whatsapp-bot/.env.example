# Mai WhatsApp Automation Service - Environment Configuration Example

# Server listening port (default: 3001)
PORT=3001

# Server listening host inside container (default: 0.0.0.0)
HOST=0.0.0.0

# API Secret Key for Bearer authentication
# Required for /status, /qr, /send-message, and /reset-session
# Generate a high-entropy secret (e.g., openssl rand -hex 32)
API_SECRET_KEY=change_me_to_a_secure_random_token_32_bytes_plus

# Session data directory for whatsapp-web.js LocalAuth persistence
SESSION_DATA_PATH=./.wwebjs_auth

# Optional: Path to custom Chromium executable
# In Docker, this is automatically set to /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# Rate Limiting & Queue Configuration
QUEUE_MAX_SIZE=100
RATE_LIMIT_MIN_MS=3000
RATE_LIMIT_MAX_MS=8000

# SECURITY NOTICE:
# docker-compose.yml maps host port 127.0.0.1:3001:3001 only.
# Do NOT open port 3001 to the public internet on Oracle Cloud without an HTTPS reverse proxy (e.g., Caddy/Nginx)
# to prevent transmitting the Bearer API_SECRET_KEY in cleartext.
