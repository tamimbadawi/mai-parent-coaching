# Copy these from your Supabase project dashboard's Connect dialog.
# Do not commit the secret key or any real credentials.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-service-role-secret
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Frontend Vite env vars used by the existing browser client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Public Bunny Stream identifiers only. Keep API and embed token keys in Supabase secrets.
VITE_BUNNY_STREAM_LIBRARY_ID=your-library-id
VITE_BUNNY_STREAM_CDN_HOSTNAME=your-pull-zone.b-cdn.net

# Gemini AI integration (supabase/functions/_shared/gemini.ts).
# GEMINI_API_KEY is an Edge Function secret only -- set it with
# `supabase secrets set GEMINI_API_KEY=...`, never as a VITE_ var or in this file.
# Optional: GEMINI_MODEL overrides the default model (see _shared/gemini.ts) the same way.
